# --- App ---
APP_HOST=127.0.0.1
APP_PORT=8000
DB_PATH=./wallet.db
PENDING_TTL_SECONDS=60
SWEEPER_INTERVAL_SECONDS=5

# --- LLM cascade (intent parser + phraser) ---
# Cascades: Ollama (local) -> Grok (xAI) -> OpenRouter -> Deterministic
OLLAMA_URL=http://localhost:11434
LLM_CASCADE=deepseek-coder-v2:16b

# Grok (xAI API)
GROK_API_KEY=
GROK_URL=https://api.x.ai/v1
GROK_MODELS=grok-2-latest,grok-beta

# OpenRouter (cloud fallback)
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=deepseek/deepseek-chat-v3-0324:free,qwen/qwen3-4b:free,meta-llama/llama-3.3-8b-instruct:free

# --- TTS ---
# elevenlabs | edge | qwen | off
TTS_ENGINE=elevenlabs
EDGE_TTS_VOICE=en-US-AriaNeural
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
QWEN_TTS_VOICE=Ryan
QWEN_TTS_LANG=English

# ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- STT ---
STT_MODEL=base
STT_COMPUTE=int8

# --- Demo seed ---
# Override starting balances (BDT). Default: bikash=50000, others=10000
SEED_BALANCE_BIKASH=50000
SEED_BALANCE_DEFAULT=10000
